    <string name="shell_refused_title">Playback isn\'t available</string>
    <string name="shell_refused_body">Spotify refused to send the audio keys this phone needs to play music for your account. You can still browse, manage your library and control playback on your other devices.</string>
    <string name="shell_refused_detail">This is a known limitation of librespot, the open-source engine SpotifyGood uses: Spotify blocks third-party playback for some accounts. Trying again later sometimes helps.</string>
