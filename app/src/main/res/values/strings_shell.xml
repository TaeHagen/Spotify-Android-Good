    <!-- Status screens -->
    <string name="shell_premium_title">Spotify Premium required</string>
    <string name="shell_premium_body">SpotifyGood streams with the same protocol as Spotify\'s own apps, which only works for Premium accounts. Log in with a Premium account to keep listening.</string>
