<?xml version="1.0" encoding="utf-8"?>
<!-- Now-playing widget, SMALL_TALL (2x2): the artwork with play / pause below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    tools:targetApi="31">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_art_placeholder" />

    <ImageButton
        android:id="@+id/widget_play"
        style="@style/Widget.SpotifyGood.NowPlaying.Play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/media3_icon_play" />
</LinearLayout>
