<?xml version="1.0" encoding="utf-8"?>
<!-- Now-playing widget: the "Sign in" prompt (logged out). As it stands (the app's mark and name)
     it is also the layout before the first update (initialLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:clipToOutline="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    tools:targetApi="31">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_logo" />

    <TextView
        android:id="@+id/widget_message_title"
        style="@style/Widget.SpotifyGood.NowPlaying.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/widget_message_text"
        style="@style/Widget.SpotifyGood.NowPlaying.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal"
        android:text="@string/widget_sign_in_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_sign_in"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_pill_background"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="@string/playback_error_action_sign_in"
        android:textColor="@color/widget_on_primary"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
